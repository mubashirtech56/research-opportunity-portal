        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/opportunities",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"\",\n  \"positions\": -1\n}"
        }
      }
    }
